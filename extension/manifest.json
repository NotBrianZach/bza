{
  "manifest_version": 3,
  "name": "aireadalong",
  "version": "1.0.0",
  "description": "Save articles and YouTube transcripts to your aireadalong library.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "tabs"],
  "host_permissions": ["https://aireadalong.com/*", "https://www.youtube.com/*", "https://*.googlevideo.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to aireadalong",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aireadalong.com/*"],
      "js": ["content-aireadalong.js"],
      "run_at": "document_idle"
    }
  ]
}
