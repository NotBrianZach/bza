# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Feature Flags
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_IMAGES=true
NEXT_PUBLIC_ENABLE_CHARACTERS=true

# Environment — set to 'production' in prod deploys
NEXT_PUBLIC_APP_ENV=development

# Uncomment ONLY when running `npm run dev:functions` (supabase functions serve).
# NEXT_PUBLIC_FUNCTIONS_URL=http://localhost:54321
